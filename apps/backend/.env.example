NODE_ENV=development
PORT=4000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://shopscale:shopscale@localhost:5432/shopscale
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=shopscale-backend
KAFKA_GROUP_ID=shopscale-backend
KAFKA_TOPIC_DOMAIN_EVENTS=shopscale.domain.events
JWT_ACCESS_SECRET=local-access-secret-change-before-production
JWT_REFRESH_SECRET=local-refresh-secret-change-before-production
PRODUCT_CACHE_TTL_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ORDER_MAX=30
RATE_LIMIT_PAYMENT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
